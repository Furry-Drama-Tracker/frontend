{
  // 阿里云 ESA「函数和 Pages」项目配置
  // 文档：https://help.aliyun.com/zh/edge-security-acceleration/esa/user-guide/build-pages
  // 注意：本文件优先于控制台配置，存在时控制台中对应的构建配置不再生效，
  // 修改构建行为需编辑本文件并推送 Git。
  "name": "furry-drama-tracker",
  // 纯静态托管：不再使用边缘函数反代 /api、/uploads，以节省 ESA 请求/流量。
  // 前端默认直连后端源站 https://fdt-api.xiedada.net（内置默认值，见 vite.config.js 与
  // src/utils/apiBase.js），无需控制台配置；需要换源站时可在控制台「函数变量」里设置
  // VITE_API_BASE_URL 覆盖（会参与构建），或修改这两处常量。
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "assets": {
    // Vite 构建产物目录
    "directory": "./dist",
    // 未命中静态资源时返回 index.html（react-router 前端路由）。
    // API 与上传资源已改为跨域直连后端，不再需要边缘函数处理 /api、/uploads。
    "notFoundStrategy": "singlePageApplication"
  }
}
